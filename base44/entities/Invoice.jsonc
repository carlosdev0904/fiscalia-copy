{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero da nota fiscal"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "cliente_documento": {
      "type": "string",
      "description": "CPF ou CNPJ do cliente"
    },
    "descricao_servico": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do servi\u00e7o prestado"
    },
    "valor": {
      "type": "number",
      "description": "Valor da nota fiscal"
    },
    "iss_retido": {
      "type": "boolean",
      "default": false,
      "description": "ISS retido na fonte"
    },
    "aliquota_iss": {
      "type": "number",
      "description": "Al\u00edquota do ISS"
    },
    "valor_iss": {
      "type": "number",
      "description": "Valor do ISS"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "pendente_confirmacao",
        "enviada",
        "autorizada",
        "rejeitada",
        "cancelada"
      ],
      "default": "rascunho",
      "description": "Status da nota fiscal"
    },
    "motivo_rejeicao": {
      "type": "string",
      "description": "Motivo da rejei\u00e7\u00e3o (se rejeitada)"
    },
    "data_emissao": {
      "type": "string",
      "format": "date",
      "description": "Data de emiss\u00e3o"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL do PDF da nota"
    },
    "xml_url": {
      "type": "string",
      "description": "URL do XML da nota"
    },
    "codigo_verificacao": {
      "type": "string",
      "description": "C\u00f3digo de verifica\u00e7\u00e3o"
    },
    "municipio": {
      "type": "string",
      "description": "Munic\u00edpio de presta\u00e7\u00e3o do servi\u00e7o"
    }
  },
  "required": [
    "cliente_nome",
    "cliente_documento",
    "descricao_servico",
    "valor"
  ]
}